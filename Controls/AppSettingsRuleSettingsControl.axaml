<ci:RuleSettingsControlBase x:Name="This"
    x:TypeArguments="settings:AppSettingsRuleSettings"
    x:Class="ClassIsland.RateLimit.Controls.AppSettingsRuleSettingsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClassIsland.RateLimit.Controls"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:settings="clr-namespace:ClassIsland.RateLimit.Models"
    xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">

    <ci:RuleSettingsControlBase.Resources>

        <Panel x:Key="PropertyPickerPanel"
               Width="400">
            <Grid Classes="animated-intro"
                  RowDefinitions="Auto Auto *">
                <TextBlock Margin="0 0 0 8"
                           Text="选择应用设置"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <TextBox x:Name="PropertyPickerSearchBox"
                         Grid.Row="1"
                         TextChanged="SearchTextBox_OnTextChanged"
                         PlaceholderText="搜索应用设置…" />
                <ListBox Grid.Row="2"
                         Margin="0 8 0 0"
                         AutoScrollToSelectedItem="True"
                         ItemsSource="{Binding ViewModel.SearchResults}"
                         SelectionChanged="PropertyPickerList_SelectionChanged"
                         SelectionMode="Single">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="False">
                                <ci:IconText Height="23"
                                             VerticalContentAlignment="Center"
                                             Glyph="{Binding Glyph}"
                                             Text="{Binding Display}" />
                                <TextBlock Margin="4 0 0 0"
                                           VerticalAlignment="Center"
                                           Text="{Binding PreviewValue, Mode=OneTime}"
                                           DockPanel.Dock="Right"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           MaxLines="3" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Panel>

        <local:AppSettingsRuleControlTemplateSelector x:Key="AppSettingsTemplateSelector">
            <DataTemplate x:Key=".bool">
                <ToggleSwitch Margin="0 -8 0 -6"
                              IsChecked="{Binding #This.ViewModel.InputValue}" />
            </DataTemplate>
            <DataTemplate x:Key=".int">
                <controls:FANumberBox VerticalAlignment="Center"
                                    MinWidth="147"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding #This.ViewModel.InputValue}" />
            </DataTemplate>
            <DataTemplate x:Key=".double">
                <controls:FANumberBox VerticalAlignment="Center"
                                    MinWidth="147"
                                    SpinButtonPlacementMode="Inline"
                                    Value="{Binding #This.ViewModel.InputValue, Converter={x:Static ci:NotNaNConverter.Instance}}" />
            </DataTemplate>
            <DataTemplate x:Key=".color">
                <ColorPicker HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Color="{Binding #This.ViewModel.InputValue}" />
            </DataTemplate>
            <DataTemplate x:Key=".enums">
                <ComboBox ItemsSource="{Binding #This.ViewModel.CurrentPropertyInfo.Enums}"
                          SelectedIndex="{Binding #This.ViewModel.InputValue}" />
            </DataTemplate>
            <DataTemplate x:Key=".string">
                <TextBox VerticalAlignment="Center"
                         MinWidth="200"
                         Text="{Binding #This.ViewModel.InputValue}" />
            </DataTemplate>
        </local:AppSettingsRuleControlTemplateSelector>

    </ci:RuleSettingsControlBase.Resources>

    <StackPanel Classes="settings-container"
                Spacing="8">

        <ci:IconText Glyph="&#xE713;" Text="应用设置为" />

        <ci:Field Label="属性">
            <Button Height="30"
                    VerticalAlignment="Center"
                    Click="SelectorButton_OnClick">
                <ci:IconText MinHeight="23"
                             Glyph="{Binding #This.ViewModel.CurrentPropertyInfo.Glyph, FallbackValue=&#xE7C9;}"
                             Text="{Binding #This.ViewModel.CurrentPropertyInfo.Name, FallbackValue=选择…}" />
            </Button>
        </ci:Field>

        <ci:Field Label="期望值">
            <Grid ColumnDefinitions="* Auto">
                <ContentPresenter x:Name="PropertyInputer1" />
                <Button x:Name="FillCurrentValueButton"
                        Grid.Column="1"
                        Margin="4 0 0 0"
                        Padding="8 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="FillCurrentValueButton_OnClick"
                        ToolTip.Tip="填入当前值">
                    <ci:IconText MinHeight="23" Glyph="&#xE47C;" Text="当前值" />
                </Button>
            </Grid>
        </ci:Field>
        <ContentPresenter x:Name="PropertyInputer2" />

        <TextBlock Classes="l-instructive"
                   TextWrapping="Wrap"
                   Text="当所选应用设置的当前值等于期望值时规则满足。可用规则集自身的反转开关实现“不等于”。" />
    </StackPanel>
</ci:RuleSettingsControlBase>